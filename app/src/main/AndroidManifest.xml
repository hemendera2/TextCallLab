<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- RECORD_AUDIO is optional and requested only when the user taps the in-app microphone.
         There is still no INTERNET, cellular audio access, contacts or messaging permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Only for the owner-requested one-time verified voice model download. No caller audio/text uploaded. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Discover only speech services installed on the device. -->
    <queries>
        <package android:name="com.CodeBySonu.VoxSherpa" />
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- No INTERNET, READ_PHONE_STATE or call-log permissions. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="KALLVO"
        android:icon="@drawable/app_mark"
        android:roundIcon="@drawable/app_mark"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".SecretaryActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <service
            android:name=".BixbyAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="KALLVO - Samsung Call Access">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
